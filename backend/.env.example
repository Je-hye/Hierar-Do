# =====================
# 필수 환경변수
# =====================

# Anthropic API 키 (https://console.anthropic.com/ 에서 발급)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PostgreSQL 접속 정보
POSTGRES_USER=hierardo
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=hierardo

# 백엔드 DB 연결 URL (docker-compose 환경에서는 db 서비스명 사용)
DATABASE_URL=postgresql+asyncpg://hierardo:your_secure_password_here@localhost:5432/hierardo

# =====================
# 선택적 환경변수
# =====================

# CORS 허용 출처 (쉼표로 여러 개 지정 가능)
ALLOWED_ORIGINS=http://localhost:3000

# 프론트엔드에서 접근하는 백엔드 URL (브라우저 기준)
NEXT_PUBLIC_API_URL=http://localhost:8000
